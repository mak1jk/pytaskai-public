# PyTaskAI Configuration
# Copia questo file in .env e configura le tue API keys

# === AI PROVIDERS (configura almeno uno) ===

# OpenAI (Raccomandato per iniziare)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Perplexity (per ricerca avanzata)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here

# xAI Grok
XAI_API_KEY=your-xai-api-key-here

# === CONFIGURAZIONE MODELLI ===

# Modello principale per task generation
PYTASKAI_MAIN_MODEL=gpt-4o-mini

# Modello per ricerca (se disponibile)
PYTASKAI_RESEARCH_MODEL=gpt-4o-mini

# Modello fallback
PYTASKAI_FALLBACK_MODEL=gpt-3.5-turbo

# === RATE LIMITING ===

# Requests per minuto (per evitare costi eccessivi)
PYTASKAI_RATE_LIMIT_RPM=10

# Budget massimo giornaliero in USD
PYTASKAI_DAILY_BUDGET=5.00

# === CONFIGURAZIONE AVANZATA ===

# Log level (DEBUG, INFO, WARNING, ERROR)
PYTASKAI_LOG_LEVEL=INFO

# Directory per i dati del progetto
PYTASKAI_DATA_DIR=.taskmaster

# Timeout per chiamate AI (secondi)
PYTASKAI_AI_TIMEOUT=30
EOF < /dev/null