# PyTaskAI Environment Configuration

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================

# OpenAI (Primary provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Research and analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity (Web research and LTS research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Google Gemini (Alternative provider)
GOOGLE_API_KEY=your_google_api_key_here

# xAI Grok (Alternative provider)
XAI_API_KEY=your_xai_api_key_here

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Primary task generation model
PYTASKAI_DEFAULT_MODEL=gpt-4o-mini

# Research and analysis model
PYTASKAI_RESEARCH_MODEL=anthropic/claude-3-haiku-20240307

# LTS research model (web-enabled)
PYTASKAI_LTS_MODEL=perplexity/llama-3-sonar-large-32k-online

# Best practices research model
PYTASKAI_BEST_PRACTICES_MODEL=perplexity/llama-3-sonar-large-32k-online

# Fallback model
PYTASKAI_FALLBACK_MODEL=gpt-3.5-turbo

# =============================================================================
# AI BEHAVIOR CONFIGURATION
# =============================================================================

# Temperature settings
PYTASKAI_DEFAULT_TEMPERATURE=0.7
PYTASKAI_RESEARCH_TEMPERATURE=0.3
PYTASKAI_SEARCH_TEMPERATURE=0.1

# Token limits
PYTASKAI_MAX_TOKENS=4096

# =============================================================================
# DATA DIRECTORY CONFIGURATION
# =============================================================================

# PyTaskAI data directory (default: .pytaskai)
PYTASKAI_DATA_DIR=.pytaskai

# =============================================================================
# BUDGET AND USAGE CONFIGURATION
# =============================================================================

# Monthly budget limit in USD
PYTASKAI_MONTHLY_BUDGET=50.00

# Cost tracking enabled
PYTASKAI_COST_TRACKING=true

# Usage analytics enabled
PYTASKAI_USAGE_ANALYTICS=true